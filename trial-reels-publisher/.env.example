# Copy to .env.personal (used with --account personal) or .env.test (--account test), or .env (no --account).
# Fill in locally, then: chmod 600 <file>. All .env* files except this one are git-ignored.
# Cloudflare R2 needs NO credentials here: you pass the public MP4 URL with --video-url.
# Never paste tokens into chats, commits, screenshots or shell history.

# Facebook Login / Instagram Professional account (graph.facebook.com path)
IG_USER_ID=YOUR_IG_PROFESSIONAL_ID
IG_ACCESS_TOKEN=PASTE_LOCALLY_ONLY
GRAPH_API_VERSION=v27.0

TRIAL_REELS_DIR=~/Documents/Trial-Reels
# MANUAL (default): stays a trial until you graduate it in the Instagram app.
# SS_PERFORMANCE: Instagram may auto-graduate it if it performs well (not guaranteed).
TRIAL_GRADUATION_STRATEGY=MANUAL
DEFAULT_CAPTION=
TIMEZONE=America/Denver
LOG_LEVEL=INFO

# Optional: ffmpeg location if it's not on PATH (used only for fast-start copies)
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional tuning
# POLL_INTERVAL_SECONDS=5
# POLL_TIMEOUT_SECONDS=300
# HTTP_TIMEOUT_SECONDS=30
# UPLOAD_TIMEOUT_SECONDS=600
# MAX_RETRIES=3
